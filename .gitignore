# Only track Python scripts — ignore all outputs and data

# Output files
*.png
!assets/*.png
*.csv
*.pdf
*.pptx

# Markdown (except README and CLAUDE.md)
*.md
!README.md
!CLAUDE.md

# Data files
*.txt
!requirements.txt
*.db
*.obo
*.xlsx
*.log
*.hdf5
*.gz
*.tsv

# FARM pipeline: don't track data, results, resources, logs
farm_pipeline/data/
farm_pipeline/results/
farm_pipeline/resources/
farm_pipeline/logs/

# Python cache
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
