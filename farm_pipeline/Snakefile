# -----------------------------------------------------------------------------
# 05. Cis-regulatory motif enrichment (FIMO + JASPAR/PlantTFDB)
# -----------------------------------------------------------------------------
rule promoter_extract:
    input:
        genome = f"{RESOURCES}/genome/genome.fna",
        gff    = f"{RESOURCES}/genome/genome.gff",
    output:
        promoters = f"{RESOURCES}/promoters_{config[motif_enrichment][promoter_upstream_bp]}bp.fa",
    log: "logs/05a_promoter_extract.log"
    resources:
        mem_mb = 8000,
        runtime = 60,
    shell:
        """
        set +u; source /etc/profile.d/modules.sh; module load conda/base; conda activate grbv-extended; set -u
        python scripts/05a_extract_promoters.py \
            --genome {input.genome} --gff {input.gff} \
            --upstream_bp {config[motif_enrichment][promoter_upstream_bp]} \
            --out {output.promoters} &> {log}
        """

rule motif_enrichment:
    input:
        promoters = f"{RESOURCES}/promoters_{config[motif_enrichment][promoter_upstream_bp]}bp.fa",
        motifs    = f"{RESOURCES}/motifs/jaspar_plants.meme",
        modules   = config["inputs"]["modules_xlsx"],
    output:
        enrichment = f"{RESULTS}/05_motif_enrichment/module_motif_enrichment.csv",
    log: "logs/05b_motif_enrichment.log"
    resources:
        mem_mb = 8000,
        runtime = 60,
        cpus_per_task = 4,
    shell:
        """
        set +u; source /etc/profile.d/modules.sh; module load conda/base; conda activate grbv-extended; set -u
        python scripts/05b_motif_enrichment.py \
            --promoters {input.promoters} --motifs {input.motifs} --modules {input.modules} \
            --out {output.enrichment} --qvalue {config[motif_enrichment][fimo_qvalue]} \
            --threads {resources.cpus_per_task} &> {log}
        """

