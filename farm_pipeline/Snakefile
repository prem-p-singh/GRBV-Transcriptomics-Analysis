# -----------------------------------------------------------------------------
# 07. Multi-omics integration (MOFA+)
# -----------------------------------------------------------------------------
rule mofa_integration:
    input:
        counts = config["inputs"]["counts"],
        meta   = config["inputs"]["metadata"],
        titer  = config["inputs"]["titer"],
        w2021  = config["inputs"]["weather_2021"],
        w2022  = config["inputs"]["weather_2022"],
    output:
        factors = f"{RESULTS}/07_mofa/mofa_factors.csv",
        varexp  = f"{RESULTS}/07_mofa/variance_explained.png",
        model   = f"{RESULTS}/07_mofa/mofa_model.hdf5",
    log: "logs/07_mofa.log"
    resources:
        mem_mb = 16000,
        runtime = 120,
        cpus_per_task = 4,
    shell:
        """
        set +u; source /etc/profile.d/modules.sh; module load conda/base; conda activate grbv-extended; set -u
        python scripts/07_mofa.py \
            --counts {input.counts} --meta {input.meta} --titer {input.titer} \
            --weather_2021 {input.w2021} --weather_2022 {input.w2022} \
            --out_factors {output.factors} --out_varexp {output.varexp} --out_model {output.model} \
            --n_factors {config[mofa][n_factors]} --n_iter {config[mofa][n_iter]} \
            --top_var {config[mofa][top_var_expr]} &> {log}
        """

