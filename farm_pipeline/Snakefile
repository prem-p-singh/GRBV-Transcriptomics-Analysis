# 18. Segmented regression on cohort age (rec #6)
# -----------------------------------------------------------------------------
rule segmented_cohort:
    input:
        counts = config["inputs"]["counts"],
        meta   = config["inputs"]["metadata"],
        mes    = config["inputs"]["mes_csv"],
    output:
        summary = f"{RESULTS}/18_segmented/segmented_summary.csv",
    log: "logs/18_segmented.log"
    resources:
        mem_mb = 4000, runtime = 20, cpus_per_task = 1,
    shell:
        """
        export GRBV_RLIBS="$HOME/grbv_extended/Rlibs"
        RSCRIPT=/cvmfs/hpc.ucdavis.edu/sw/conda/environments/r-4.4.2/bin/Rscript
        $RSCRIPT scripts/18_segmented_cohort.R \
            --counts {input.counts} --meta {input.meta} --mes {input.mes} \
            --out_dir {RESULTS}/18_segmented \
            --top_var {config[segmented][top_var]} &> {log}
        """

