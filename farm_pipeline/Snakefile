import os

configfile: "config/config.yaml"

RESULTS = config["results_dir"]
RESOURCES = config["resources_dir"]

rule all:
    input:
        f"{RESULTS}/01_grn/grn_edges.tsv.gz",
        f"{RESULTS}/01_grn/hub_tfs.csv",
        f"{RESULTS}/02_module_preservation/zsummary.csv",
        f"{RESULTS}/02_module_preservation/preservation_plot.png",
        f"{RESULTS}/03_subtype_nmf/subtype_labels.csv",
        f"{RESULTS}/03_subtype_nmf/cophenetic_plot.png",
        f"{RESULTS}/04_diffcoex/rewired_edges.csv",
        f"{RESULTS}/04_diffcoex/rewired_hubs.csv",
        f"{RESULTS}/05_motif_enrichment/module_motif_enrichment.csv",
        f"{RESULTS}/06_pseudotime/pseudotime_genes.csv",
        f"{RESULTS}/06_pseudotime/trajectory_plot.png",
        f"{RESULTS}/07_mofa/mofa_factors.csv",
        f"{RESULTS}/07_mofa/variance_explained.png",
        f"{RESULTS}/08_hima/hima_mediators.csv",
        f"{RESULTS}/09_defense/defense_expression_summary.csv",
        f"{RESULTS}/09_defense/defense_heatmap.png",
        f"{RESULTS}/10_subtype_characterize/subtype_DE.csv",
        f"{RESULTS}/10_subtype_characterize/subtype_clinical.csv",

# -----------------------------------------------------------------------------
# 01. Gene regulatory network inference (GENIE3)
# -----------------------------------------------------------------------------
rule grn_inference:
    input:
        counts = config["inputs"]["counts"],
        meta   = config["inputs"]["metadata"],
        tf_list = f"{RESOURCES}/Vvi_TF_list.txt",
    output:
        edges = f"{RESULTS}/01_grn/grn_edges.tsv.gz",
        hubs  = f"{RESULTS}/01_grn/hub_tfs.csv",
    log: "logs/01_grn.log"
    resources:
        mem_mb = 32000,
        runtime = 360,
        cpus_per_task = 16,
    shell:
        """
        set +u; source /etc/profile.d/modules.sh; module load conda/base; conda activate grbv-extended; set -u
        Rscript scripts/01_grn_genie3.R \
            --counts {input.counts} --meta {input.meta} --tfs {input.tf_list} \
            --out_edges {output.edges} --out_hubs {output.hubs} \
            --n_trees {config[grn][n_trees]} --top_edges {config[grn][top_edges_export]} \
            --top_var {config[filtering][top_variable_genes]} --cores {resources.cpus_per_task} \
            &> {log}
        """

# -----------------------------------------------------------------------------
# 02. Module preservation (WGCNA — build in RB-, test in RB+)
# -----------------------------------------------------------------------------
rule module_preservation:
    input:
        counts = config["inputs"]["counts"],
        meta   = config["inputs"]["metadata"],
    output:
        zsummary = f"{RESULTS}/02_module_preservation/zsummary.csv",
        plot     = f"{RESULTS}/02_module_preservation/preservation_plot.png",
    log: "logs/02_module_preservation.log"
    resources:
        mem_mb = 16000,
        runtime = 180,
        cpus_per_task = 8,
    shell:
        """
        set +u; source /etc/profile.d/modules.sh; module load conda/base; conda activate grbv-extended; set -u
        Rscript scripts/02_module_preservation.R \
            --counts {input.counts} --meta {input.meta} \
            --out_csv {output.zsummary} --out_plot {output.plot} \
            --n_perm {config[module_preservation][n_permutations]} \
            --soft_power {config[module_preservation][soft_power]} \
            --cores {resources.cpus_per_task} &> {log}
        """

# -----------------------------------------------------------------------------
# 03. Subtype discovery in RB+ samples (consensus NMF)
# -----------------------------------------------------------------------------
rule subtype_discovery:
    input:
        counts = config["inputs"]["counts"],
        meta   = config["inputs"]["metadata"],
    output:
        labels = f"{RESULTS}/03_subtype_nmf/subtype_labels.csv",
        coph   = f"{RESULTS}/03_subtype_nmf/cophenetic_plot.png",
        consensus = f"{RESULTS}/03_subtype_nmf/consensus_matrix.png",
    log: "logs/03_subtype_nmf.log"
    resources:
        mem_mb = 8000,
        runtime = 90,
        cpus_per_task = 4,
    shell:
        """
        set +u; source /etc/profile.d/modules.sh; module load conda/base; conda activate grbv-extended; set -u
        python scripts/03_subtype_nmf.py \
            --counts {input.counts} --meta {input.meta} \
            --out_labels {output.labels} --out_coph {output.coph} --out_consensus {output.consensus} \
            --k_min 2 --k_max 6 --n_boot {config[subtype_nmf][n_bootstrap]} \
            --top_var {config[subtype_nmf][n_top_var]} &> {log}
        """

