# -----------------------------------------------------------------------------
# 00. Per-sample weather aggregates (used by rules 07 + 08)
# -----------------------------------------------------------------------------
rule weather_aggregate:
    input:
        meta  = config["inputs"]["metadata"],
        w2021 = config["inputs"]["weather_2021"],
        w2022 = config["inputs"]["weather_2022"],
        cfg   = "config/config.yaml",
    output:
        csv = f"{RESULTS}/00_weather/weather_per_sample.csv",
    log: "logs/00_weather.log"
    resources:
        mem_mb = 2000,
        runtime = 15,
    shell:
        """
        export GRBV_RLIBS="$HOME/grbv_extended/Rlibs"
        PY=$HOME/.conda/envs/grbv-extended/bin/python
        RSCRIPT=/cvmfs/hpc.ucdavis.edu/sw/conda/environments/r-4.4.2/bin/Rscript
        $PY scripts/00_weather_aggregate.py \
            --meta {input.meta} --weather_2021 {input.w2021} --weather_2022 {input.w2022} \
            --config {input.cfg} --out {output.csv} &> {log}
        """

# -----------------------------------------------------------------------------
# 01. Gene regulatory network inference (GENIE3)
# -----------------------------------------------------------------------------
rule grn_inference:
    input:
        counts = config["inputs"]["counts"],
        meta   = config["inputs"]["metadata"],
        tf_list = f"{RESOURCES}/Vvi_TF_list.txt",
        gff     = f"{RESOURCES}/genome/genome.gff",
    output:
        edges = f"{RESULTS}/01_grn/grn_edges.tsv.gz",
        hubs  = f"{RESULTS}/01_grn/hub_tfs.csv",
    log: "logs/01_grn.log"
    resources:
        mem_mb = 32000,
        runtime = 360,
        cpus_per_task = 16,
    shell:
        """
        export GRBV_RLIBS="$HOME/grbv_extended/Rlibs"
        PY=$HOME/.conda/envs/grbv-extended/bin/python
        RSCRIPT=/cvmfs/hpc.ucdavis.edu/sw/conda/environments/r-4.4.2/bin/Rscript
        $RSCRIPT scripts/01_grn_genie3.R \
            --counts {input.counts} --meta {input.meta} --tfs {input.tf_list} --gff {input.gff} \
            --out_edges {output.edges} --out_hubs {output.hubs} \
            --n_trees {config[grn][n_trees]} --top_edges {config[grn][top_edges_export]} \
            --top_var {config[filtering][top_variable_genes]} --cores {resources.cpus_per_task} \
            &> {log}
        """

